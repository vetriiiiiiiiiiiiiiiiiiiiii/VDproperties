# ── Database ───────────────────────────────────────────────
# PostgreSQL connection string. For local dev, `npm run db:local` starts a server on port 5434.
DATABASE_URL="postgresql://vdp:vdp_local_only@localhost:5434/vdp_app"

# ── Site ───────────────────────────────────────────────────
# Public base URL, used for canonical URLs, sitemap and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "false" on staging to send noindex headers for every page.
ALLOW_INDEXING="true"

# Maximum public form submissions per IP address per 10 minutes, per form type.
FORM_RATE_LIMIT="6"
# Sign-in attempts and account registrations allowed per IP (per 15 minutes / per hour).
LOGIN_RATE_LIMIT="10"
REGISTER_RATE_LIMIT="5"

# ── Maps (Property Twin & search map) ────────────────────
# Tile provider. Defaults to OpenStreetMap, whose usage policy suits low traffic only — use a commercial provider in production.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""
# Optional satellite layer; the layer switcher appears only when this is set.
NEXT_PUBLIC_SATELLITE_TILE_URL=""
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=""

# ── Uploads ────────────────────────────────────────────────
# "local" stores files on disk in UPLOAD_DIR (use a persistent volume in production).
# "s3" stores files in any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces…).
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# Required when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects in the bucket, e.g. https://media.example.com
S3_PUBLIC_URL=""

# ── Email (Resend, https://resend.com) ─────────────────────
# Sends password resets, email confirmations, customer updates and staff lead alerts.
# Without a key, leads and in-account updates are still saved, but password reset can't work
# and email confirmation isn't required.
RESEND_API_KEY=""
# Must use a domain verified in Resend, e.g. V D Properties <no-reply@yourdomain.com>
MAIL_FROM=""
# Comma-separated list of staff addresses that receive new-lead notifications.
LEAD_NOTIFICATION_EMAILS=""
# Development and tests only: write emails to this folder as JSON instead of sending them.
MAIL_CAPTURE_DIR=""

# ── Google sign-in for customers (optional) ────────────────
# The "Continue with Google" button appears only when both are set.
# Authorised redirect URI in Google Cloud: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── First administrator (used only by `npm run db:seed`) ──
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# "true" adds clearly labelled sample listings for development. Never enable in production.
SEED_SAMPLE_CONTENT="false"
